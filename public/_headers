# POSI Badge SVGs are static-exported Route Handler output with no file
# extension (out/api/badge/<code>/<variant>) — without this, Cloudflare
# Pages' default MIME-type-by-extension lookup falls back to a generic
# content type and browsers refuse to render them inside <img> tags.
# charset=utf-8 is required, not cosmetic: badge SVGs embed the journal's own
# title text, and any journal with a non-ASCII title (e.g. Chinese) fails to
# render entirely in an <img> tag without an explicit charset declaration —
# ASCII-only titles happened to work anyway, which is what made this easy to
# miss initially.
/api/badge/*
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=86400

# POSI Core Collection certificate PDFs — same extension-less static Route
# Handler output as the badges above, same fix required.
/api/certificate/*
  Content-Type: application/pdf
  Cache-Control: public, max-age=86400

# Global Benchmark publisher-catalog data (~5 MB) used to be a same-origin
# static asset here, fetched client-side by /ratings/mature,
# /ratings/early-stage, and /citation-reports. As of 2026-08-13 it's fetched
# directly from data.posi.panorama-sg.com (posi-data-delivery) instead — see
# src/lib/publisher-catalog-client.ts — so this repo no longer serves it at
# all, and this cache rule is gone with it.

# Static open-data files (see /datasets/). Short cache so a rebuild is
# picked up quickly; CORS open so notebooks and other sites can read them.
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/data/index/*.csv
  Content-Type: text/csv; charset=utf-8

# Browser network allow-list. Publication search runs in the visitor's
# browser and talks to these hosts directly; anything else (including any
# analytics or proxy host) is refused by the browser. Scripts and styles are
# not restricted here: the static export relies on inline bootstrap scripts.
# Add a host to connect-src only after reading its terms and checking CORS.
/*
  Content-Security-Policy: connect-src 'self' https://api.openalex.org https://api.crossref.org https://api.datacite.org https://zenodo.org https://doi.org https://openlibrary.org https://www.googleapis.com https://data.posi.panorama-sg.com; object-src 'none'; base-uri 'self'
